# Credenciais públicas do Supabase (Dashboard > Project Settings > API).
# Copie este arquivo para .env e preencha os valores. Nunca commite o .env.
#
# EXPO_PUBLIC_* entra no bundle do app (Expo SDK 57 lê .env e faz inline de
# process.env.EXPO_PUBLIC_... — não use process.env['...'] nem desestruturação).
# Por isso só URL + chave anon/public pertencem aqui.
#
# NÃO cole a service_role. Ela ignora RLS e é secreta (só servidor / SQL).
# A segurança real no cliente é Row Level Security no banco.

# Project URL, ex.: https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# anon public (JWT). NÃO use service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Nome do bucket de Storage já criado no Supabase (Dashboard > Storage).
# Padrão: avatars. Fotos de perfil vão para {userId}/avatar.*
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=avatars
