{
  "name": "Resenha UI",
  "version": "0.1.0",
  "description": "Soft UI clean — high radius, botões pílula, sombras difusas, gradiente azul/ciano.",
  "brandGradient": {
    "light": ["#6B5CFF", "#4AA4FF", "#5BE7F0"],
